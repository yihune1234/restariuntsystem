# ===========================================================
# Frontend environment variables (Vite)
# Copy this file to `.env` and fill in real values. Do NOT commit
# `.env`. Only variables prefixed with `VITE_` are exposed to the
# browser bundle.
# ===========================================================

# Backend REST API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Socket.IO connection URL (for realtime updates)
VITE_SOCKET_URL=http://localhost:5000

# Public client origin used for QR / callback links
VITE_CLIENT_URL=http://localhost:5173

# Deployment environment: development | production
VITE_ENVIRONMENT=development