# Environment Configuration
# NOTE: The runtime expects MONGODB_URI (see src/config/env.js). Do NOT commit
# real credentials here - only placeholder values. Copy this file to .env and
# fill in real secrets locally. Both .env and .env.example are git-ignored.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/restaurant?appName=Cluster0

# JWT Configuration
JWT_ACCESS_SECRET=replace_with_a_random_32_plus_character_secret
JWT_REFRESH_SECRET=replace_with_another_random_32_plus_character_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Customer Session
CUSTOMER_SESSION_EXPIRES_IN_HOURS=6

# Cloudinary Image Storage (placeholders only — do NOT put real keys here)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Chapa Payment Gateway
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=http://localhost:5000/api/v1/payments/chapa/webhook
# Must end with a slash; the branchId and orderId are appended automatically
# (e.g. /customer/confirmed/<branchId>/<orderId>).
CHAPA_RETURN_URL=http://localhost:5173/customer/confirmed/
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_key

# Client URLs / CORS
# CLIENT_URL can be comma-separated for payment redirects if needed
CLIENT_URL=http://localhost:3000
# SOCKET_CORS_ORIGIN accepts comma-separated origins for both HTTP and Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
